# Leave blank in local Vite development: /api is proxied to 127.0.0.1:3001.
VITE_API_URL=

# Production Passport. Override only when deliberately testing another deployment.
VITE_PASSPORT_ORIGIN=https://passport.pubky.app

# Set this to the deployed HTTPS frontend origin to enable secure callback fallback.
# On plain HTTP localhost the SDK relay still authenticates; callbacks are omitted.
VITE_PUBLIC_ORIGIN=
